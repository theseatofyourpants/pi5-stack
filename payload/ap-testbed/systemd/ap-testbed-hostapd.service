[Unit]
Description=AP Testbed — hostapd (5GHz AP on the dongle)
PartOf=ap-testbed.target
Requires=ap-testbed-net.service
After=ap-testbed-net.service
BindsTo=ap-testbed-net.service

[Service]
Type=simple
ExecStart=/usr/sbin/hostapd /run/ap-testbed/hostapd.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=ap-testbed.target
