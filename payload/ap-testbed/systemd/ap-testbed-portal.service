[Unit]
Description=AP Testbed — consent portal (authorization gate) + scan trigger
PartOf=ap-testbed.target
Requires=ap-testbed-net.service
After=ap-testbed-net.service
BindsTo=ap-testbed-net.service

[Service]
Type=simple
User=__STACK_USER__
# Bind :80 on the AP IP only, as an unprivileged user.
Environment=PORTAL_PORT=80
Environment=PORTAL_BIND=10.66.66.1
# Dongle-triggered bring-up means ARMED: a consenting device gets a real,
# scope-locked, non-destructive /web-assess scan (trigger-scan.sh). The consent
# gate + per-device cooldown + kill switch (logs/HALT) still apply. To run the
# whole stack disarmed instead, set ARM_OFFENSIVE=0 here (or `touch logs/HALT`).
Environment=ARM_OFFENSIVE=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/bin/python3 __AP_DIR__/consent-portal/portal.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=ap-testbed.target
