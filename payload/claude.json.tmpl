{
  "mcpServers": {
    "hexstrike": {
      "command": "{{HOME}}/hexstrike-ai-community-edition/hexstrike-env/bin/python3",
      "args": [
        "{{HOME}}/hexstrike-ai-community-edition/hexstrike_mcp.py",
        "--server",
        "http://localhost:8899"
      ]
    },
    "pentest-ai": {
      "command": "{{HOME}}/pentest-ai/venv/bin/ptai",
      "args": [
        "mcp"
      ]
    },
    "mcp-kali-server": {
      "command": "{{HOME}}/MCP-Kali-Server/venv/bin/python3",
      "args": [
        "{{HOME}}/MCP-Kali-Server/mcp-server/mcp_server.py",
        "--server",
        "http://localhost:5000"
      ]
    },
    "wstg-pentest": {
      "command": "{{HOME}}/.local/bin/uv",
      "args": [
        "--directory",
        "{{HOME}}/autopentest-ai/server",
        "run",
        "server.py"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    },
    "sliver-c2": {
      "command": "/usr/bin/node",
      "args": [
        "{{HOME}}/sec-sliver-c2-mcp/dist/index.js",
        "--operator-config",
        "{{HOME}}/sliver-claude.cfg"
      ],
      "env": {
        "PYTHON_PATH": "{{HOME}}/sec-sliver-c2-mcp/venv/bin/python3"
      }
    },
    "mythic": {
      "command": "{{HOME}}/Mythic-MCP/mythic-mcp",
      "args": [],
      "env": {
        "MYTHIC_URL": "https://localhost:7443",
        "MYTHIC_USERNAME": "mythic_admin",
        "MYTHIC_PASSWORD": "{{MYTHIC_PASSWORD}}",
        "MYTHIC_SKIP_TLS_VERIFY": "true",
        "MCP_TRANSPORT": "stdio"
      }
    },
    "caido": {
      "command": "{{HOME}}/.local/bin/caido-mcp-server",
      "args": [
        "serve"
      ],
      "env": {
        "CAIDO_URL": "{{CAIDO_URL}}"
      }
    },
    "virustotal": {
      "command": "npx",
      "args": [
        "-y",
        "@burtthecoder/mcp-virustotal"
      ],
      "env": {
        "VIRUSTOTAL_API_KEY": "{{VT_API_KEY}}"
      }
    },
    "greynoise": {
      "command": "{{HOME}}/greynoise-mcp/venv/bin/python",
      "args": [
        "{{HOME}}/greynoise-mcp/server.py"
      ],
      "env": {
        "GREYNOISE_API_KEY": "{{GREYNOISE_API_KEY}}"
      }
    }
  }
}
