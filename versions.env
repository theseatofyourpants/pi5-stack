# versions.env — pin everything so a rebuild is reproducible. Bump deliberately.
# Refs below are the commits currently deployed on the source Pi (captured from
# the live clones), so a rebuild reproduces the known-good state.

# --- toolchains / base ---
GO_VERSION="1.26.5"                 # ~/go-sdk
DOCKER_COMPOSE_VERSION="v5.4.0"     # compose v2 plugin binary (Kali docker.io doesn't bundle it); blank => latest

# --- C2 (opt-in layers 50/51) ---
SLIVER_VERSION="v1.7.3"             # ~/.local/bin/sliver-server (arm64)
MYTHIC_VERSION="v3.4.0"             # ~/Mythic (mythic-cli)

# --- phishing infra (opt-in layer 52; for /phish-sim) ---
EVILGINX_REPO="https://github.com/kgretzky/evilginx2.git"
EVILGINX_COMMIT="4c0988a1d9db4d172a185e979a38bfd0efdb5830"   # 2026-06-10, built arm64
# gophish = Kali apt package (no pin)

# --- hot-pot deception layer (installed by layer 30 when Docker is present) ---
# Cowrie is the only externally-pulled image; the smb/fake-admin/collector images are
# built locally from payload/ap-testbed/hotpot/ (their "version" is this repo's commit).
# compose pins Cowrie by digest (not :latest) so a rebuild is reproducible — bump deliberately.
COWRIE_IMAGE="cowrie/cowrie"
COWRIE_DIGEST="sha256:dd1dbad5b564729f2536c360c4719fcf73bf3c6a3bd61e86d6b1f9924d15eb28"  # cowrie/cowrie:latest as of 2026-07 on the source Pi

# --- web-assessment gap fills (layer 20 via install-web-tools.sh) ---
# SSTImap is clone-and-run upstream (no pyproject/setup.py), so it is pinned by
# commit and installed to ~/SSTImap with its own venv + a ~/.local/bin wrapper.
# Fills the template-injection gap: web-assess had sqlmap/dalfox/JWT/GraphQL but
# no SSTI engine at all.
SSTIMAP_REPO="https://github.com/vladko312/SSTImap.git"
SSTIMAP_COMMIT="d4f09055b15967b0e2265f20eb348a7ec2f25a2c"   # 2026-04-25, master

# --- analysis / RE helpers (layer 55) ---
# GEF, not PEDA: hexstrike's gdb_peda_debug hardcodes `source ~/peda/peda.py`,
# which has never existed on either host -- so the stack had NO gdb enhancement.
# GEF's aarch64 support is also well ahead of PEDA's, and both hosts are arm64.
GEF_TAG="2026.01"
# CyberChef: local, offline decode workbench for the ctf-* skills. Bound to
# loopback + tailnet ONLY (never 0.0.0.0) -- same posture as the lab-guard work.
CYBERCHEF_IMAGE="mpepping/cyberchef"
CYBERCHEF_DIGEST="sha256:55f7f50c0612d55b4d774c3e8345d0cfbf0bc0c10117c8998961f0d144533126"
CYBERCHEF_PORT="8000"

# --- sensors (opt-in layer 60) ---
SURICATA_VERSION="7.0.10"           # built from source (Kali arm64 DPDK dep unusable)
ZEEK_VERSION="8.2.1"                # OpenSUSE OBS repo (Debian_12), NOT Kali apt

# --- core MCP servers (layer 20) ---
HEXSTRIKE_REPO="https://github.com/CommonHuman-Lab/hexstrike-ai-community-edition.git"
HEXSTRIKE_REF="92d1968"
HEXSTRIKE_PORT="8899"               # moved off :8888 (Mythic jupyter collision)
KALI_MCP_REPO="https://github.com/TriV3/MCP-Kali-Server.git"
KALI_MCP_REF="18fdf22"
KALI_BACKEND_PORT="5000"
WSTG_REPO="https://github.com/bhavsec/autopentest-ai.git"   # provides the wstg-pentest MCP
WSTG_REF="5dee231"
PENTEST_AI_PIP="ptai==1.2.1"        # pip package in a venv (NOT a git clone). 1.2.1 = first release supporting Python 3.14 (Kali rolling); earlier pins cap at <3.14
# virustotal: npx @burtthecoder/mcp-virustotal | playwright: npx @playwright/mcp
# NOTE: these two are launched through {{NPX_BIN}}, resolved to an ABSOLUTE path at
# render time. A bare "npx" is not enough — on this stack npm is not installed and
# npx comes from Debian's corepack shims, which are not on PATH.
# greynoise: local (payload/greynoise-mcp) — deps: httpx + mcp

# --- MCP servers for opt-in layers ---
SLIVER_MCP_REPO="https://github.com/schwarztim/sec-sliver-c2-mcp"
SLIVER_MCP_REF="261bccc"
MYTHIC_MCP_REPO="https://github.com/nbaertsch/Mythic-MCP"
MYTHIC_MCP_REF="77730e6"
CAIDO_MCP_REPO="https://github.com/c0tton-fluff/caido-mcp-server.git"
CAIDO_MCP_REF="53b0625"

# --- node toolchain ---
# npm is NOT a standalone package on this stack; it comes from Debian's corepack
# shims. Corepack otherwise auto-pulls the LATEST npm (12.x), which requires node
# >= 22.22.2 while apt only offers 22.22.0 — producing a "does not support Node.js"
# warning on every npx-based MCP launch (virustotal, playwright). Pin until node is
# bumped; see the node-toolchain note. Do NOT "fix" this by raising the pin.
NPM_PIN="11.19.0"

# --- Claude Code (the CLI the agents, skills and headless timers all run on) ---
# "latest" tracks the native installer's current release; pin an exact version here
# (e.g. 2.1.237) to make a rebuild reproducible. Claude Code self-updates in place
# afterwards either way.
CLAUDE_CODE_VERSION="latest"

# --- ports Mythic owns (keep clear) ---
MYTHIC_GRAPHQL_PORT="8080"
MYTHIC_JUPYTER_PORT="8888"
AP_ADMIN_PORT="8787"
