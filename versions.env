# versions.env — pin everything so a rebuild is reproducible. Bump deliberately.
# (Some repo URLs/refs are marked TODO — confirmed & pinned when the layer that
#  uses them is implemented in step 2.)

# --- toolchains / base ---
GO_VERSION="1.26.5"                 # ~/go-sdk
# pipx, cargo, feroxbuster, x8 etc. handled by ap-testbed/install-web-tools.sh

# --- C2 ---
SLIVER_VERSION="v1.7.3"             # ~/.local/bin/sliver-server (arm64)
MYTHIC_VERSION="v3.4.0"             # ~/Mythic (mythic-cli)

# --- sensors ---
SURICATA_VERSION="7.0.10"           # built from source (Kali arm64 DPDK dep unusable)
ZEEK_VERSION="8.2.1"                # OpenSUSE OBS repo (Debian_12), NOT Kali apt
# bettercap: Kali apt

# --- MCP servers (pin to a tag/commit in step 2) ---
CAIDO_MCP_REPO="https://github.com/c0tton-fluff/caido-mcp-server"
CAIDO_MCP_REF="v4.2.2"
SLIVER_MCP_REPO="https://github.com/schwarztim/sec-sliver-c2-mcp"
SLIVER_MCP_REF="TODO-pin"
MYTHIC_MCP_REPO="https://github.com/nbaertsch/Mythic-MCP"
MYTHIC_MCP_REF="TODO-pin"
HEXSTRIKE_DIR="hexstrike-ai-community-edition"   # repo URL: TODO-confirm
HEXSTRIKE_PORT="8899"               # moved off :8888 (Mythic jupyter collision)
KALI_MCP_REPO="https://github.com/Wh0am123/MCP-Kali-Server"   # TODO-confirm
# virustotal: @burtthecoder/mcp-virustotal (npx)  | greynoise: local payload/greynoise-mcp
# wstg-pentest / pentest-ai / playwright: TODO-confirm source in step 2

# --- ports that must stay clear (Mythic owns these) ---
MYTHIC_GRAPHQL_PORT="8080"
MYTHIC_JUPYTER_PORT="8888"
AP_ADMIN_PORT="8787"
