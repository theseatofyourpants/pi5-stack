# secrets.example.env — copy to secrets.env (which is git-IGNORED) and fill in.
#   cp secrets.example.env secrets.env && chmod 600 secrets.env
# bootstrap.sh reads secrets.env and will interactively prompt for anything blank
# that a selected layer needs (offering to save it back here for next time).
#
# NEVER commit secrets.env. Only this .example file (with blank values) is tracked.

# VirusTotal API key (free tier is fine). Used by the virustotal MCP.
VT_API_KEY=

# GreyNoise API key — OPTIONAL. The custom greynoise MCP works keyless via the
# community endpoint; a key unlocks context/riot/quick/gnql.
GREYNOISE_API_KEY=

# Mythic admin password. Leave BLANK — it's generated at Mythic's first boot and
# the 51-c2-mythic layer captures it and writes it here for you.
MYTHIC_PASSWORD=

# Mythic admin username (default). Change only if you customise Mythic.
MYTHIC_USERNAME=mythic_admin

# Caido runs on your x86_64 laptop (no arm64 build). Point the caido MCP at it.
CAIDO_URL=http://<laptop-ip>:8080

# NOTE: these are generated fresh on each rebuild and are NOT stored here:
#   - AP testbed admin password  (ap-testbed/state/admin.pass)
#   - Sliver operator mTLS config (~/sliver-claude.cfg)
#   - Caido MCP auth token        (~/.config/caido-mcp-server/)

# Captive-portal HTTPS cert (for modern-Android auto-pop). NOT stored here — the
# cert is issued by certbot via a Cloudflare DNS-01 challenge. The Cloudflare API
# token lives in /root/.secrets/certbot/cloudflare.ini (root-only, never committed).
# The captive subdomain (e.g. captive.theseatofyourpants.com) is hardcoded in
# ap-testbed/conf/dnsmasq-ap.conf.template (the address=/…/ hijack + option 114 URL).
# See layer 30-ap-testbed for the guided setup.
